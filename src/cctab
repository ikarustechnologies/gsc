# compile aux programs for gsc v1.1
set STRIP = ""
if ("$1" =~ [Ss]*) set STRIP = "strip"
cc -I. r_region.c $CDSBIN/libsimbad.a -lc -lm -o r_region
cc -I. tod.c gsc_enc.c $CDSBIN/libsimbad.a -lc -lm -o gsc_enc
cc -I. tod.c tr_regions.c $CDSBIN/libsimbad.a -lc -lm -o tr_regions
cc -I. get_header.c decode_c.c gsc_dec.c $CDSBIN/libsimbad.a -lc -lm -o gsc_dec
if ("$STRIP" != "") then
        echo "strip gsc_enc, gsc_dec, tr_regions, r_region"
        strip gsc_enc
        strip tr_regions
        strip r_region
        strip gsc_dec
endif
rm *.o
mv gsc_enc $PATHBIN
mv tr_regions $PATHBIN
mv r_region $PATHBIN
mv gsc_dec $PATHBIN
exit $status
